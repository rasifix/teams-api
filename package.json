{
  "name": "teams-api",
  "version": "1.0.0",
  "description": "Express.js API for My Teams application",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test:ci": "npm run build && npm run test:schema && npm run test:aliases && npm run test:permissions && npm run test:planning && npm run test:activities && npm run test:phase-4-6 && npm run test:legacy-compat",
    "test:schema": "tsx test/phase-0-schema-test.ts",
    "test:aliases": "tsx test/phase-1-alias-test.ts",
    "test:permissions": "tsx test/permission-restrictions-test.ts",
    "test:planning": "tsx test/match-planning-test.ts",
    "test:activities": "tsx test/phase-2-3-test.ts",
    "test:phase-4-6": "tsx test/phase-4-6-test.ts",
    "test:legacy-compat": "tsx test/legacy-frontend-compat-test.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:restart": "docker-compose restart",
    "docker:logs": "docker-compose logs -f mongodb",
    "docker:reset": "docker-compose down -v && docker-compose up -d"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
